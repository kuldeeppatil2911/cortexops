{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "frontend/build/index.html",
      "status": 200
    }
  ],
  "env": {
    "REACT_APP_API_BASE_URL": "@react-app-api-base-url"
  }
}
